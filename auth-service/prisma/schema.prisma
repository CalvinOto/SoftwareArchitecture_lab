generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model users {
  user_id  String @id @db.VarChar(36)
  username String @db.VarChar(55)
  email    String @unique @db.VarChar(255)
  password String @db.VarChar(255)
  country  String @db.VarChar(55)
  role     String @db.VarChar(25)
}