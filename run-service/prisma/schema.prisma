generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model runs {
  run_id          String     @id @db.VarChar(36)
  run_category_id String     @db.VarChar(36)
  user_id         String     @db.VarChar(36)
  vod_url         String     @db.VarChar(255)
  run_duration    BigInt
  submitted_at    DateTime
  verified_at     DateTime?
  status          String     @db.VarChar(25)
  comments        comments[]
}

model comments {
  comment_id String   @id @db.VarChar(36)
  run_id     String   @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  comment    String   @db.VarChar(255)
  created_at DateTime
  run        runs     @relation(fields: [run_id], references: [run_id])
}